<Window x:Class="FreeFlow.App.UI.RecordingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FreeFlow.App.UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False">

    <!--
        The capsule. Deliberately small and bottom-centered: it has to confirm the
        mic is live without covering what the user is dictating into.

        ShowActivated and IsHitTestVisible are both false so the overlay never takes
        focus or swallows a click. Stealing focus here would break the paste, because
        the transcript has to land in the window the user was already typing in.
    -->

    <Border Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="16,10"
            Margin="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.34" Color="#000000" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal">

            <!-- Live dot. The only place the signal color appears. -->
            <Ellipse x:Name="LiveDot"
                     Width="8" Height="8"
                     Fill="{DynamicResource Live}"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0" />

            <ui:AmplitudeMeter x:Name="Meter"
                               Height="22"
                               BarBrush="{DynamicResource Live}"
                               VerticalAlignment="Center" />

            <Rectangle Width="1"
                       Margin="14,2,14,2"
                       Fill="{DynamicResource Line}" />

            <TextBlock x:Name="StatusLabel"
                       Text="Listening"
                       Style="{DynamicResource BodyText}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <!-- Mode badge, drawn as a keycap so it matches every other shortcut in the app. -->
            <Border x:Name="ModeBadge" Style="{DynamicResource Keycap}">
                <TextBlock x:Name="ModeLabel"
                           Text="Hold"
                           Style="{DynamicResource KeycapText}" />
            </Border>

        </StackPanel>
    </Border>
</Window>
