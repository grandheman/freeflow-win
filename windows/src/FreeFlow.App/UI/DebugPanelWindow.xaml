<Window x:Class="FreeFlow.App.UI.DebugPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pipeline history"
        Width="920" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}">

    <!--
        A list of recent runs beside the full detail of the selected one. This exists
        to answer one question when a dictation comes out wrong: which stage did it?
        So the raw transcript, the context, and the exact prompt are all shown
        verbatim rather than summarized.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Background="{DynamicResource SurfaceSunken}">
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,1,0,0"
                    Padding="14,12">
                <Button Content="Clear history"
                        Style="{DynamicResource QuietButton}"
                        HorizontalAlignment="Stretch"
                        Click="OnClearClicked" />
            </Border>

            <Border DockPanel.Dock="Top" Padding="18,16,18,10">
                <StackPanel>
                    <TextBlock Text="RUNS" Style="{DynamicResource EyebrowText}" Margin="0,0,0,4" />
                    <TextBlock x:Name="EmptyLabel"
                               Text="Nothing recorded yet. Turn on pipeline history in Settings, then dictate."
                               Style="{DynamicResource CaptionText}"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <ListBox x:Name="RunList"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="10,0,10,10"
                     SelectionChanged="OnRunSelected" />
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel x:Name="DetailHost" />
        </ScrollViewer>
    </Grid>
</Window>
