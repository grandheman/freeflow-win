<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light values. Only the color tokens are redefined; every style in Theme.xaml
        resolves them through DynamicResource, so switching themes needs no other
        change and no control carries a hardcoded color.

        The signal color shifts slightly darker here. The dark-theme coral is too
        light to hold contrast against a white surface, and the overlay has to stay
        readable at a glance in both themes.
    -->

    <Color x:Key="SurfaceColor">#FBFBFD</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSunkenColor">#F1F2F6</Color>
    <Color x:Key="LineColor">#E1E2E8</Color>

    <Color x:Key="InkColor">#17181C</Color>
    <Color x:Key="InkDimColor">#5F616B</Color>
    <Color x:Key="InkFaintColor">#8E909A</Color>

    <Color x:Key="LiveColor">#E24A22</Color>
    <Color x:Key="LiveSoftColor">#FDEDE7</Color>

    <Color x:Key="DangerColor">#D93A3A</Color>
    <Color x:Key="FocusColor">#2F6BE0</Color>

</ResourceDictionary>
